<atom:Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:reminders="clr-namespace:perinma.Views.Reminders"
             x:DataType="reminders:ReminderListViewModel"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
             x:Class="perinma.Views.Reminders.ReminderNotificationWindow"
             Title="Reminders" Width="450" MaxHeight="600" MinHeight="200" SizeToContent="Height"
             CanResize="False" WindowStartupLocation="CenterOwner"
             Icon="/Assets/avalonia-logo.ico"
             ShowInTaskbar="True">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Background="{DynamicResource AppAccentBrush}"
                Padding="16,12"
                CornerRadius="8,8,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Upcoming Reminders"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextOnAccentBrush}"/>

                    <TextBlock Text="{Binding Reminders.Count, StringFormat='{}{0} event(s)'}"
                               FontSize="12"
                               Opacity="0.85"
                               Foreground="{DynamicResource AppTextOnAccentBrush}"/>
                </StackPanel>

                <atom:Button x:Name="DismissAllButton"
                             Grid.Column="1"
                             Content="Dismiss All"
                             ButtonType="Primary"
                             Command="{Binding DismissAllCommand}"
                             IsEnabled="{Binding Reminders.Count, Mode=OneWay}"/>
            </Grid>
        </Border>

        <atom:ScrollViewer x:Name="ReminderListScrollViewer"
                           Grid.Row="1"
                           VerticalScrollBarVisibility="Auto"
                           HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Reminders}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="reminders:ReminderViewModel">
                        <reminders:ReminderItemControl/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </atom:ScrollViewer>
    </Grid>
</atom:Window>
