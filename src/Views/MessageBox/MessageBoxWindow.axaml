<atom:Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="150"
             x:Class="perinma.Views.MessageBox.MessageBoxWindow"
             SizeToContent="Height"
             Width="400"
             MinHeight="120"
             CanResize="False"
             WindowStartupLocation="CenterOwner"
             ShowInTaskbar="False">

    <Grid Margin="20" RowDefinitions="Auto,Auto" RowSpacing="20">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="15">
            <Border x:Name="IconHost"
                    Width="40"
                    Height="40"
                    CornerRadius="20"
                    VerticalAlignment="Top">
                <atom:IconPresenter x:Name="TypeIconPresenter"
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
            </Border>

            <TextBlock x:Name="MessageText"
                       Grid.Column="1"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       MaxWidth="300"/>
        </Grid>

        <StackPanel x:Name="ButtonPanel"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">
            <atom:Button x:Name="OkButton"
                         Content="OK"
                         Width="80"
                         IsVisible="False"
                         Click="OnOkClicked" />
            <atom:Button x:Name="CancelButton"
                         Content="Cancel"
                         Width="80"
                         IsVisible="False"
                         Click="OnCancelClicked" />
            <atom:Button x:Name="YesButton"
                         Content="Yes"
                         Width="80"
                         IsVisible="False"
                         Click="OnYesClicked" />
            <atom:Button x:Name="NoButton"
                         Content="No"
                         Width="80"
                         IsVisible="False"
                         Click="OnNoClicked" />
        </StackPanel>
    </Grid>
</atom:Window>
