<atom:Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cal="using:perinma.Views.Calendar"
             xmlns:callist="using:perinma.Views.CalendarList"
             xmlns:contacts="using:perinma.Views.Contacts"
             xmlns:main="using:perinma.Views.Main"
             xmlns:debug="using:perinma.Views.Debug"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             Width="1200" Height="600"
             x:Class="perinma.Views.Main.MainWindow"
             x:DataType="main:MainWindowViewModel"
             Icon="/Assets/avalonia-logo.ico"
             Title="perinma: Personal Information Manager">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <main:MainWindowViewModel/>
    </Design.DataContext>
    
    <Grid x:Name="MainGrid" RowDefinitions="Auto,*,Auto">
        <!-- Menu Bar with View Switcher -->
        <DockPanel Grid.Row="0">
            <atom:Menu DockPanel.Dock="Left" x:Name="MainMenu">
                <atom:MenuItem Header="_File">
                    <atom:MenuItem Header="_Settings" Name="MnuSettings" Command="{Binding ShowSettingsCommand}"/>
                    <atom:MenuItem Header="_Sync" Command="{Binding SyncCommand}"/>
                    <atom:MenuItem Header="_Exit" Name="MnuExit" Click="MnuExit_OnClick"/>
                </atom:MenuItem>
                <atom:MenuItem Header="_View">
                    <atom:MenuItem Header="_Calendar" Command="{Binding ShowCalendarViewCommand}">
                        <MenuItem.Icon>
                            <atom:CheckBox IsChecked="{Binding IsCalendarViewActive}" IsHitTestVisible="False"/>
                        </MenuItem.Icon>
                    </atom:MenuItem>
                    <atom:MenuItem Header="C_ontacts" Command="{Binding ShowContactsViewCommand}">
                        <MenuItem.Icon>
                            <atom:CheckBox IsChecked="{Binding IsContactsViewActive}" IsHitTestVisible="False"/>
                        </MenuItem.Icon>
                    </atom:MenuItem>
                    <atom:Separator/>

                    <atom:MenuItem Header="_Theme">
                        <atom:MenuItem Header="_Light" Command="{Binding SetLightThemeCommand}">
                            <MenuItem.Icon>
                                <atom:CheckBox IsChecked="{Binding IsLightTheme}" IsHitTestVisible="False"/>
                            </MenuItem.Icon>
                        </atom:MenuItem>
                        <atom:MenuItem Header="_Dark" Command="{Binding SetDarkThemeCommand}">
                            <MenuItem.Icon>
                                <atom:CheckBox IsChecked="{Binding IsDarkTheme}" IsHitTestVisible="False"/>
                            </MenuItem.Icon>
                        </atom:MenuItem>
                    </atom:MenuItem>
                </atom:MenuItem>
                <atom:MenuItem Header="_Tools">
                    <atom:MenuItem Header="_Debug" Command="{Binding ShowDebugWindowCommand}"/>
                </atom:MenuItem>
                <atom:MenuItem Header="_Help">
                    <atom:MenuItem Header="_About" Command="{Binding ShowAboutCommand}"/>
                </atom:MenuItem>
            </atom:Menu>

            <!-- View Switcher Buttons -->
            <StackPanel DockPanel.Dock="Right" 
                        Orientation="Horizontal" 
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Spacing="4">
                <ToggleButton Content="Calendar" 
                              IsChecked="{Binding IsCalendarViewActive}"
                              Command="{Binding ShowCalendarViewCommand}"
                              Padding="12,4"
                              FontSize="12"/>
                <ToggleButton Content="Contacts" 
                              IsChecked="{Binding IsContactsViewActive}"
                              Command="{Binding ShowContactsViewCommand}"
                              Padding="12,4"
                              FontSize="12"/>
            </StackPanel>
            
            <Border/> <!-- Spacer -->
        </DockPanel>
        
        <!-- Main Content Area -->
        <Panel Grid.Row="1">
            <!-- Calendar View -->
            <Grid x:Name="CalendarViewGrid" IsVisible="{Binding IsCalendarViewActive}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" MinWidth="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0"
                        BorderBrush="{DynamicResource AppChromeBorderBrush}"
                        BorderThickness="0,0,1,0">
                    <callist:CalendarListView DataContext="{Binding CalendarListViewModel}"/>
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="4"
                              Background="Transparent"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"/>

                <!-- Calendar Views - switch based on ViewMode -->
                <Grid Grid.Column="2" RowDefinitions="Auto,*">
                    <!-- Navigation Bar -->
                    <cal:CalendarNavigationBar Grid.Row="0"
                                            DataContext="{Binding $parent[Window].((main:MainWindowViewModel)DataContext).CalendarNavigationBarViewModel}"/>

                    <!-- Calendar Views Panel -->
                    <Panel Grid.Row="1">
                        <!-- Month View -->
                        <cal:CalendarMonthView DataContext="{Binding CalendarMonthViewModel}"
                                             IsVisible="{Binding $parent[Window].((main:MainWindowViewModel)DataContext).IsMonthView}"/>

                        <!-- Week View -->
                        <cal:CalendarWeekView DataContext="{Binding CalendarWeekViewModel}"
                                            IsVisible="{Binding $parent[Window].((main:MainWindowViewModel)DataContext).IsWeekView}"/>

                        <!-- Agenda View -->
                        <cal:CalendarAgendaView DataContext="{Binding CalendarAgendaViewModel}"
                                                IsVisible="{Binding $parent[Window].((main:MainWindowViewModel)DataContext).IsAgendaView}"/>
                    </Panel>
                </Grid>
            </Grid>
            
            <!-- Contacts View -->
            <contacts:ContactsView IsVisible="{Binding $parent[Window].((main:MainWindowViewModel)DataContext).IsContactsViewActive}"
                                   DataContext="{Binding ContactsViewModel}"/>
        </Panel>

        <!-- Status Bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource AppPanelSubtleBrush}"
                BorderBrush="{DynamicResource AppChromeBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8"
                MinHeight="32">

            <Grid ColumnDefinitions="Auto,*">
                <!-- Progress Indicator (only shows during sync) -->
                <atom:ProgressBar Grid.Column="0"
                            Width="80"
                            Height="3"
                            Margin="0,0,12,0"
                            IsIndeterminate="{Binding SyncProgressIsIndeterminate}"
                            Value="{Binding SyncProgress}"
                            IsVisible="{Binding IsSyncing}"
                            Foreground="{DynamicResource AppAccentBrush}"
                            Background="{DynamicResource AppPanelSubtleBrush}"/>

                <!-- Status Text -->
                <TextBlock Grid.Column="1"
                           Text="{Binding SyncStatusText, FallbackValue='Ready'}"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
    </Grid>
</atom:Window>
