<atom:Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settings="using:perinma.Views.Settings"
             x:DataType="settings:SettingsViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="perinma.Views.Settings.SettingsWindow"
             Title="Settings"
             Width="800"
             Height="600">
    <Grid ColumnDefinitions="220,*">
        <Border Grid.Column="0"
                Background="{DynamicResource AppPanelSubtleBrush}"
                BorderBrush="{DynamicResource AppChromeBorderBrush}"
                BorderThickness="0,0,1,0">
            <atom:NavMenu Name="SettingsNav"
                          Mode="Vertical"
                          Width="220"
                          ItemsSource="{Binding Pages}"
                          SelectedItem="{Binding SelectedPage}"/>
        </Border>

        <Border Grid.Column="1"
                Padding="20">
            <ContentControl Name="ContentArea"
                            Content="{Binding SelectedPage.ViewModel}" />
        </Border>
    </Grid>
</atom:Window>
