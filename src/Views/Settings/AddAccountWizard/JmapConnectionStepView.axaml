<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wizard="using:perinma.Views.Settings.AddAccountWizard"
             x:DataType="wizard:JmapConnectionStepViewModel"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="perinma.Views.Settings.AddAccountWizard.JmapConnectionStepView">

    <StackPanel Margin="20" Spacing="15">
        <TextBlock Text="JMAP Server Details" FontSize="18" FontWeight="SemiBold" />

        <TextBlock Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource AppTextSecondaryBrush}" />

        <StackPanel Spacing="5">
            <TextBlock Text="Session URL" />
            <atom:LineEdit x:Name="SessionUrlInput"
                           Text="{Binding SessionUrl}"
                           PlaceholderText="https://mail.example.com/.well-known/jmap" />
        </StackPanel>

        <StackPanel Spacing="5">
            <TextBlock Text="Authentication" />
            <atom:ComboBox x:Name="AuthenticationModeComboBox"
                           SelectedItem="{Binding AuthenticationMode}">
                <ComboBox.Items>
                    <wizard:JmapAuthenticationMode>UsernamePassword</wizard:JmapAuthenticationMode>
                    <wizard:JmapAuthenticationMode>BearerToken</wizard:JmapAuthenticationMode>
                </ComboBox.Items>
            </atom:ComboBox>
        </StackPanel>

        <StackPanel Spacing="5" IsVisible="{Binding IsUsernamePasswordMode}">
            <TextBlock Text="Username" />
            <atom:LineEdit x:Name="UsernameInput"
                           Text="{Binding Username}"
                           PlaceholderText="user@example.com" />
        </StackPanel>

        <StackPanel Spacing="5" IsVisible="{Binding IsUsernamePasswordMode}">
            <TextBlock Text="Password / App Password" />
            <atom:LineEdit x:Name="PasswordInput"
                           Text="{Binding Password}"
                           PasswordChar="•" />
        </StackPanel>

        <StackPanel Spacing="5" IsVisible="{Binding IsBearerTokenMode}">
            <TextBlock Text="Bearer Token" />
            <atom:LineEdit x:Name="BearerTokenInput"
                           Text="{Binding BearerToken}"
                           PlaceholderText="Paste bearer token" />
        </StackPanel>
    </StackPanel>
</UserControl>
