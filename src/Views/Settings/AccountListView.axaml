<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settings="using:perinma.Views.Settings"
             x:DataType="settings:AccountListViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="perinma.Views.Settings.AccountListView">

    <StackPanel Margin="20">
        <DockPanel Margin="0,0,0,20">
            <atom:TextBlock Text="Accounts" FontSize="24" FontWeight="Bold" DockPanel.Dock="Left" />
            <atom:Button x:Name="AddAccountButton"
                         Content="Add Account"
                         Command="{Binding AddAccountCommand}"
                         HorizontalAlignment="Right"
                         DockPanel.Dock="Right" />
        </DockPanel>

        <ItemsControl ItemsSource="{Binding Accounts}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="settings:AccountViewModel">
                    <Border BorderBrush="{DynamicResource AppChromeBorderBrush}" BorderThickness="1" CornerRadius="5"
                            Padding="10" Margin="0,0,0,10">
                        <DockPanel>
                            <atom:DropdownButton x:Name="AccountActionsButton"
                                                 Content="Actions"
                                                 VerticalAlignment="Center"
                                                 ButtonType="Link"
                                                 DockPanel.Dock="Right">
                                <atom:DropdownButton.DropdownFlyout>
                                    <atom:MenuFlyout>
                                        <atom:MenuItem
                                            Header="Force Resync"
                                            Command="{Binding ForceResyncCommand}" />
                                        <atom:MenuItem
                                            Header="Reauthenticate"
                                            Command="{Binding ReauthenticateCommand}"
                                            IsVisible="{Binding SupportsReauthentication}"
                                            IsEnabled="{Binding CanReauthenticate}" />
                                        <atom:MenuItem
                                            Header="Delete"
                                            Command="{Binding DeleteCommand}"
                                            Foreground="Red" />
                                    </atom:MenuFlyout>
                                </atom:DropdownButton.DropdownFlyout>
                            </atom:DropdownButton>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Type}" FontSize="12"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="No accounts configured"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                   IsVisible="{Binding !Accounts.Count}" />
    </StackPanel>
</UserControl>