<atom:Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:atom="https://atomui.net"
             xmlns:mail="using:perinma.Views.Mail"
             x:Class="perinma.Views.Mail.LocalDraftsWindow"
             x:DataType="mail:LocalDraftsViewModel"
             mc:Ignorable="d"
             Width="680"
             Height="420"
             MinWidth="520"
             MinHeight="320"
             Title="Local Drafts">
    <Grid RowDefinitions="*,Auto"
          Margin="14"
          RowSpacing="10">
        <atom:ListBox ItemsSource="{Binding Drafts}"
                      SelectedItem="{Binding SelectedDraft}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="mail:LocalDraftItemViewModel">
                    <Border Padding="8,6"
                            Background="Transparent">
                        <StackPanel Spacing="3">
                            <DockPanel>
                                <TextBlock Text="{Binding Subject}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding UpdatedText}"
                                           FontSize="11"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           Margin="8,0,0,0"/>
                            </DockPanel>
                            <TextBlock Text="{Binding RecipientSummary}"
                                       FontSize="11"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding StatusText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </atom:ListBox>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto,Auto,Auto"
              ColumnSpacing="8">
            <TextBlock Grid.Column="0"
                       Text="{Binding StatusText}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"/>
            <atom:Button Grid.Column="1"
                         Content="Delete"
                         Command="{Binding DeleteSelectedDraftCommand}"
                         Padding="10,4"/>
            <atom:Button Grid.Column="2"
                         Content="Cancel"
                         Command="{Binding CancelCommand}"
                         Padding="10,4"/>
            <atom:Button Grid.Column="3"
                         Content="Open"
                         Command="{Binding OpenSelectedDraftCommand}"
                         Padding="12,4"/>
        </Grid>
    </Grid>
</atom:Window>
