<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mail="using:perinma.Views.Mail"
             xmlns:web="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.WebView"
             x:Class="perinma.Views.Mail.SecureMailHtmlView"
             x:DataType="mail:SecureMailHtmlView"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="480">

    <Panel>
        <web:NativeWebView x:Name="PreviewWebView" />

        <Border x:Name="PlaceholderBorder"
                Background="{DynamicResource AppPanelSubtleBrush}"
                CornerRadius="4"
                Padding="12"
                IsVisible="False">
            <TextBlock x:Name="PlaceholderTextBlock"
                       TextWrapping="Wrap"/>
        </Border>
    </Panel>
</UserControl>
