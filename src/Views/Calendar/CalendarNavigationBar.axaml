<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cal="using:perinma.Views.Calendar"
             x:DataType="cal:CalendarNavigationBarViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="60"
             x:Class="perinma.Views.Calendar.CalendarNavigationBar">
    
    <Grid Margin="0, 10, 0, 10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- View Mode Switcher -->
        <atom:Segmented Grid.Column="0"
                        Name="ViewModeGroup"
                        HorizontalAlignment="Left"
                        Margin="10, 0, 0, 0"
                        SelectedIndex="{Binding SelectedViewIndex, Mode=TwoWay}">
            <atom:SegmentedItem Name="MonthViewButton"
                                Content="Month"
                                FontSize="12"/>
            <atom:SegmentedItem Name="WeekViewButton"
                                Content="Week"
                                FontSize="12"/>
            <atom:SegmentedItem Name="WorkWeekViewButton"
                                Content="Work Week"
                                FontSize="12"/>
            <atom:SegmentedItem Name="DayViewButton"
                                Content="Day"
                                FontSize="12"/>
            <atom:SegmentedItem Name="AgendaViewButton"
                                Content="Agenda"
                                FontSize="12"/>
        </atom:Segmented>

        <!-- Navigation Controls (Center) -->
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="8">
            <atom:Button Name="PreviousButton"
                         Command="{Binding PreviousCommand}"
                         Margin="0, 0, 8, 0"
                         Padding="8, 4"
                         atom:ToolTip.Tip="Previous"
                         Content="←"/>

            <TextBlock Text="{Binding DateRangeDisplay}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0, 0, 8, 0"/>

            <atom:Button Name="TodayButton"
                         Command="{Binding TodayCommand}"
                         Margin="0, 0, 8, 0"
                         Padding="8, 4"
                         atom:ToolTip.Tip="Today"
                         FontSize="12"
                         Content="Today"/>

            <atom:Button Name="NextButton"
                         Command="{Binding NextCommand}"
                         Padding="8, 4"
                         atom:ToolTip.Tip="Next"
                         Content="→"/>
        </StackPanel>

        <!-- Create Event (Right) -->
        <atom:Button Grid.Column="2"
                     Name="CreateEventButton"
                     Command="{Binding CreateNewEventCommand}"
                     Content="Create Event"
                     ButtonType="Primary"
                     FontSize="12"
                     Padding="8, 4"
                     Margin="10, 0, 10, 0"/>
    </Grid>
</UserControl>
