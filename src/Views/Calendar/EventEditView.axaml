<atom:Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cal="using:perinma.Views.Calendar"
             xmlns:edit="using:perinma.Views.Calendar.EventEdit"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="520"
             x:Class="perinma.Views.Calendar.EventEditView"
             x:DataType="cal:EventEditViewModel"
             Title="{Binding WindowTitle}"
             Width="500" Height="520"
             WindowStartupLocation="CenterOwner">

    <atom:Window.Styles>
        <Style Selector="Button.SmallButton">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="MinWidth" Value="20"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.SmallButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
        </Style>
        <Style Selector="Button.FieldRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,10,12,10"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Button.FieldRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="FontStyle" Value="Italic"/>
        </Style>
        <Style Selector="NumericUpDown.TimeInput">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="ShowButtonSpinner" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="NumericUpDown.TimeInput /template/ TextBox">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </atom:Window.Styles>

    <atom:Window.Resources>
    </atom:Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <!-- Calendar selector -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,10">
            <TextBlock Text="Calendar" FontWeight="SemiBold" FontSize="12"/>
            <atom:ComboBox x:Name="CalendarComboBox"
                           ItemsSource="{Binding Calendars}"
                           SelectedItem="{Binding SelectedCalendar}"
                           HorizontalAlignment="Stretch"
                           PlaceholderText="Select Calendar">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="12" Height="12" Fill="{Binding Color}"
                                     Stroke="{DynamicResource AppTextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </atom:ComboBox>
        </StackPanel>

        <!-- Field list -->
        <atom:ScrollViewer x:Name="FieldListScrollViewer" Grid.Row="1" Margin="0,0,0,10">
            <Border BorderBrush="{DynamicResource AppChromeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>

                    <!-- Title: always visible, outside the collapsible rows -->
                    <atom:TextBox Text="{Binding TitleField.Title}"
                             PlaceholderText="Event title"
                             FontSize="15"
                             FontWeight="SemiBold"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="12,12,12,12"/>

                    <!-- Collapsible field rows -->
                    <ItemsControl ItemsSource="{Binding FieldRows}">
                        <ItemsControl.ItemTemplate>
                            <!-- Single template: header defined once here, body varies by field type -->
                            <DataTemplate DataType="edit:FieldRow">
                                <Border BorderThickness="0,1,0,0"
                                        BorderBrush="{DynamicResource AppChromeBorderBrush}">
                                    <StackPanel>

                                        <!-- Expand/collapse header -->
                                        <atom:Button Classes="FieldRow"
                                                Command="{Binding ToggleExpandedCommand}">
                                            <Grid ColumnDefinitions="20,*,20">
                                                <TextBlock Text="{Binding Icon}" FontSize="13"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Field.Summary}"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           Classes.muted="{Binding !Field.HasValue}"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Chevron}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                            </Grid>
                                        </atom:Button>

                                        <!-- Type-specific editor body -->
                                        <ContentControl IsVisible="{Binding IsExpanded}"
                                                        Content="{Binding Field}"
                                                        Margin="40,4,12,12">
                                            <ContentControl.DataTemplates>

                                                <DataTemplate DataType="edit:TimeRangeEditViewModel">
                                                    <StackPanel Spacing="8">
                                                        <atom:CheckBox Content="All-day event"
                                                                  IsChecked="{Binding IsFullDay}"
                                                                  IsVisible="{Binding IsFullDaySupported}"/>
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="Start" FontWeight="SemiBold" FontSize="12"/>
                                                            <Grid ColumnDefinitions="*,8,Auto">
                                                                <atom:DatePicker x:Name="StartDatePicker"
                                                                                 SelectedDateTime="{Binding StartDate}"
                                                                                 HorizontalAlignment="Stretch"/>
                                                                <StackPanel Grid.Column="2"
                                                                            Orientation="Horizontal" Spacing="4"
                                                                            VerticalAlignment="Center"
                                                                            IsVisible="{Binding !IsFullDay}">
                                                                    <atom:NumericUpDown Classes="TimeInput" Width="52"
                                                                                   Value="{Binding StartHour}"
                                                                                   Minimum="0" Maximum="23"
                                                                                   FormatString="00"
                                                                                   Increment="1"/>
                                                                    <TextBlock Text=":" FontSize="14" FontWeight="SemiBold"
                                                                               VerticalAlignment="Center"/>
                                                                    <atom:NumericUpDown Classes="TimeInput" Width="52"
                                                                                   Value="{Binding StartMinute}"
                                                                                   Minimum="0" Maximum="59"
                                                                                   FormatString="00"
                                                                                   Increment="1"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </StackPanel>
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="End" FontWeight="SemiBold" FontSize="12"/>
                                                            <Grid ColumnDefinitions="*,8,Auto">
                                                                <atom:DatePicker x:Name="EndDatePicker"
                                                                                 SelectedDateTime="{Binding EndDate}"
                                                                                 HorizontalAlignment="Stretch"/>
                                                                <StackPanel Grid.Column="2"
                                                                            Orientation="Horizontal" Spacing="4"
                                                                            VerticalAlignment="Center"
                                                                            IsVisible="{Binding !IsFullDay}">
                                                                    <atom:NumericUpDown Classes="TimeInput" Width="52"
                                                                                   Value="{Binding EndHour}"
                                                                                   Minimum="0" Maximum="23"
                                                                                   FormatString="00"
                                                                                   Increment="1"/>
                                                                    <TextBlock Text=":" FontSize="14" FontWeight="SemiBold"
                                                                               VerticalAlignment="Center"/>
                                                                    <atom:NumericUpDown Classes="TimeInput" Width="52"
                                                                                   Value="{Binding EndMinute}"
                                                                                   Minimum="0" Maximum="59"
                                                                                   FormatString="00"
                                                                                   Increment="1"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>

                                                <DataTemplate DataType="edit:ReminderEditViewModel">
                                                    <StackPanel Spacing="8">
                                                        <atom:CheckBox Content="Enable reminder"
                                                                  IsChecked="{Binding HasReminder}"/>
                                                        <atom:ComboBox ItemsSource="{Binding ReminderOptions}"
                                                                  SelectedItem="{Binding SelectedReminderOption}"
                                                                  HorizontalAlignment="Stretch"
                                                                  IsVisible="{Binding HasReminder}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Label}"
                                                                               VerticalAlignment="Center"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </atom:ComboBox>
                                                    </StackPanel>
                                                </DataTemplate>

                                                <DataTemplate DataType="edit:RecurrenceEditViewModel">
                                                    <StackPanel Spacing="8">
                                                        <atom:CheckBox Content="Repeat this event"
                                                                  IsChecked="{Binding IsRecurring}"
                                                                  IsEnabled="{Binding CanEdit}"/>
                                                        <TextBlock Text="{Binding ReadOnlyReason}"
                                                                   Classes.muted="True"
                                                                   IsVisible="{Binding !CanEdit}"/>
                                                        <StackPanel Spacing="8" IsVisible="{Binding ShowEditor}">
                                                            <Grid ColumnDefinitions="Auto,8,Auto,8,*">
                                                                <TextBlock Text="Frequency" VerticalAlignment="Center"/>
                                                                <atom:ComboBox Grid.Column="2"
                                                                          ItemsSource="{Binding FrequencyOptions}"
                                                                          SelectedItem="{Binding SelectedFrequency}"
                                                                          MinWidth="120">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Label}"/>
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </atom:ComboBox>
                                                                <TextBlock Grid.Column="4" Text="Every" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                            </Grid>
                                                            <Grid ColumnDefinitions="Auto,8,*" RowDefinitions="Auto,8,Auto,8,Auto">
                                                                <TextBlock Text="Interval" VerticalAlignment="Center"/>
                                                                <atom:NumericUpDown Grid.Column="2"
                                                                               Value="{Binding Interval}"
                                                                               Minimum="1"
                                                                               Maximum="365"
                                                                               Increment="1"
                                                                               HorizontalAlignment="Left"
                                                                               Width="96"/>
                                                                <TextBlock Grid.Row="2" Text="Days" VerticalAlignment="Top"
                                                                           IsVisible="{Binding ShowWeeklyDays}"/>
                                                                <ItemsControl Grid.Row="2" Grid.Column="2"
                                                                              ItemsSource="{Binding Weekdays}"
                                                                              IsVisible="{Binding ShowWeeklyDays}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel Orientation="Horizontal"/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate DataType="edit:WeekdaySelectionViewModel">
                                                                            <atom:CheckBox Content="{Binding Label}"
                                                                                      IsChecked="{Binding IsSelected}"
                                                                                      Margin="0,0,8,4"/>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <TextBlock Grid.Row="4" Text="Ends" VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Row="4" Grid.Column="2" Spacing="8">
                                                                    <atom:ComboBox ItemsSource="{Binding EndOptions}"
                                                                              SelectedItem="{Binding SelectedEndOption}"
                                                                              MinWidth="180"
                                                                              HorizontalAlignment="Left">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding Label}"/>
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </atom:ComboBox>
                                                                    <atom:NumericUpDown Value="{Binding Count}"
                                                                                   Minimum="1"
                                                                                   Maximum="999"
                                                                                   Increment="1"
                                                                                   HorizontalAlignment="Left"
                                                                                   Width="96"
                                                                                   IsVisible="{Binding ShowEndCount}"/>
                                                                    <atom:DatePicker x:Name="UntilDatePicker"
                                                                                     SelectedDateTime="{Binding UntilDate}"
                                                                                     HorizontalAlignment="Left"
                                                                                     Width="180"
                                                                                     IsVisible="{Binding ShowEndDate}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>

                                                <DataTemplate DataType="edit:DescriptionEditViewModel">
                                                    <atom:TextBox Text="{Binding Description}"
                                                             PlaceholderText="Description"
                                                             AcceptsReturn="True"
                                                             TextWrapping="Wrap"
                                                             HorizontalAlignment="Stretch"
                                                             Height="80"/>
                                                </DataTemplate>

                                                <DataTemplate DataType="edit:LocationEditViewModel">
                                                    <atom:TextBox Text="{Binding Location}"
                                                             PlaceholderText="Location"
                                                             HorizontalAlignment="Stretch"/>
                                                </DataTemplate>

                                                <DataTemplate DataType="edit:ParticipantsEditViewModel">
                                                    <StackPanel Spacing="8">
                                                        <ItemsControl ItemsSource="{Binding SelectedParticipants}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel Orientation="Horizontal"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="edit:ParticipantEditItemViewModel">
                                                                    <Border Background="{DynamicResource AppSelectionSubtleBrush}"
                                                                            CornerRadius="16"
                                                                            Padding="6,4"
                                                                            Margin="0,0,4,4">
                                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                                            <Border Width="24" Height="24" CornerRadius="12"
                                                                                    Background="{DynamicResource AppAccentBrushLight2}">
                                                                                <Panel>
                                                                                    <Image Source="{Binding PhotoBitmap}"
                                                                                           Stretch="UniformToFill"
                                                                                           IsVisible="{Binding HasPhoto}"/>
                                                                                    <TextBlock Text="{Binding Initials}"
                                                                                               FontSize="10" FontWeight="SemiBold"
                                                                                               Foreground="White"
                                                                                               HorizontalAlignment="Center"
                                                                                               VerticalAlignment="Center"
                                                                                               IsVisible="{Binding !HasPhoto}"/>
                                                                                </Panel>
                                                                            </Border>
                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="{Binding DisplayName}"
                                                                                       FontSize="13"
                                                                                       VerticalAlignment="Center"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       Margin="6,0,0,0"/>
                                                                            <Border Grid.Column="2"
                                                                                    Background="{DynamicResource AppHyperlinkBrush}"
                                                                                    CornerRadius="8"
                                                                                    Padding="4,2"
                                                                                    Margin="6,0,0,0"
                                                                                    IsVisible="{Binding IsOptional}">
                                                                                <TextBlock Text="Optional"
                                                                                           FontSize="10"
                                                                                           Foreground="White"/>
                                                                            </Border>
                                                                            <atom:Button Grid.Column="3"
                                                                                    Classes="SmallButton"
                                                                                    Padding="4"
                                                                                    Command="{Binding RemoveCommand}">
                                                                                <TextBlock Text="✕" FontSize="12"/>
                                                                            </atom:Button>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Grid>
                                                            <atom:TextBox x:Name="SearchTextBox"
                                                                     Text="{Binding SearchText}"
                                                                     PlaceholderText="Add participants"
                                                                     HorizontalAlignment="Stretch"
                                                                     KeyDown="OnSearchTextBoxKeyDown"/>
                                                            <atom:Popup x:Name="ParticipantSearchPopup"
                                                                        IsOpen="{Binding IsDropdownOpen}"
                                                                        PlacementTarget="{Binding ElementName=SearchTextBox}"
                                                                        Placement="Bottom"
                                                                        MaxHeight="250">
                                                                <Border Background="{DynamicResource AppPanelMutedBrush}"
                                                                        BorderBrush="{DynamicResource AppChromeStrongBorderBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="4"
                                                                        Padding="4">
                                                                    <ItemsControl ItemsSource="{Binding SearchResults}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate DataType="edit:ParticipantEditItemViewModel">
                                                                                <atom:Button Background="Transparent"
                                                                                            BorderThickness="0"
                                                                                            Padding="0"
                                                                                            HorizontalAlignment="Stretch"
                                                                                            HorizontalContentAlignment="Stretch"
                                                                                            Command="{Binding $parent[ItemsControl].((edit:ParticipantsEditViewModel)DataContext).AddFromContactCommand}"
                                                                                            CommandParameter="{Binding}">
                                                                                    <Border Padding="8,4" CornerRadius="4">
                                                                                        <Border.Styles>
                                                                                            <Style Selector="Border:pointerover">
                                                                                                <Setter Property="Background"
                                                                                                        Value="{DynamicResource AppHoverBrush}"/>
                                                                                            </Style>
                                                                                        </Border.Styles>
                                                                                        <Grid ColumnDefinitions="Auto,*">
                                                                                            <Border Width="32" Height="32" CornerRadius="16"
                                                                                                    Background="{DynamicResource AppAccentBrushLight2}">
                                                                                                <Panel>
                                                                                                    <Image Source="{Binding PhotoBitmap}"
                                                                                                           Stretch="UniformToFill"
                                                                                                           IsVisible="{Binding HasPhoto}"/>
                                                                                                    <TextBlock Text="{Binding Initials}"
                                                                                                               FontSize="12" FontWeight="SemiBold"
                                                                                                               Foreground="White"
                                                                                                               HorizontalAlignment="Center"
                                                                                                               VerticalAlignment="Center"
                                                                                                               IsVisible="{Binding !HasPhoto}"/>
                                                                                                </Panel>
                                                                                            </Border>
                                                                                            <StackPanel Grid.Column="1" Spacing="2" Margin="8,0,0,0">
                                                                                                <TextBlock Text="{Binding DisplayName}"
                                                                                                           FontSize="13" FontWeight="SemiBold"
                                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                                                <TextBlock Text="{Binding Email}"
                                                                                                           FontSize="11"
                                                                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                                            </StackPanel>
                                                                                        </Grid>
                                                                                    </Border>
                                                                                </atom:Button>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Border>
                                                            </atom:Popup>
                                                        </Grid>
                                                        <atom:Button Content="Check availability →"
                                                                HorizontalAlignment="Right"
                                                                Command="{Binding $parent[Window].((cal:EventEditViewModel)DataContext).CheckAvailabilityCommand}"
                                                                IsVisible="{Binding HasValue}"
                                                                Padding="6,3"
                                                                FontSize="12"/>
                                                    </StackPanel>
                                                </DataTemplate>

                                            </ContentControl.DataTemplates>
                                        </ContentControl>

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>
        </atom:ScrollViewer>

        <!-- Error + Buttons -->
        <StackPanel Grid.Row="2" Spacing="8">
            <Border IsVisible="{Binding ErrorMessage}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource AppErrorBrushBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"/>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <atom:Button Content="Save"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding !IsSaving}"
                        MinWidth="100"/>
                <atom:Button x:Name="CancelButton"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                        MinWidth="100"/>
            </StackPanel>
        </StackPanel>

    </Grid>
</atom:Window>
