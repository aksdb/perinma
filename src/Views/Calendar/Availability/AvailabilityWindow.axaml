<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:atom="https://atomui.net"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:av="using:perinma.Views.Calendar.Availability"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="560"
        x:Class="perinma.Views.Calendar.Availability.AvailabilityWindow"
        x:DataType="av:AvailabilityWindowViewModel"
        Title="Check Availability"
        Width="760" Height="560"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.ParticipantName">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style Selector="Border.organizer TextBlock.ParticipantName">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Border.SlotOverlay">
            <Setter Property="Background" Value="#33007AFF"/>
            <Setter Property="BorderBrush" Value="#88007AFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
            <Setter Property="Cursor" Value="SizeWestEast"/>
        </Style>
        <Style Selector="Border.ResizeHandle">
            <Setter Property="Background" Value="#88007AFF"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Cursor" Value="SizeWestEast"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="CornerRadius" Value="0,3,3,0"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="12">

        <!-- ── Row 0: day navigation + status ───────────────────────────── -->
        <Grid Grid.Row="0" RowDefinitions="Auto,Auto" Margin="0,0,0,8">

            <!-- Navigation bar -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,6">
                <atom:Button Content="◀"
                        Command="{Binding GoToPreviousDayCommand}"
                        Width="30" Height="28" Padding="4,0"
                        VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding DisplayDateLabel}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold"/>
                <atom:Button Grid.Column="2"
                        Content="▶"
                        Command="{Binding GoToNextDayCommand}"
                        Width="30" Height="28" Padding="4,0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"/>
                <atom:Button Grid.Column="3"
                        Content="↺ Refresh"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding !IsLoading}"
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- Status messages -->
            <StackPanel Grid.Row="1" Spacing="4">
                <TextBlock Text="Loading availability…"
                           FontSize="12"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           IsVisible="{Binding IsLoading}"/>
                <TextBlock Text="{Binding ErrorMessage}"
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource AppErrorBrush}"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>

        </Grid>

        <!-- ── Row 1: timeline ───────────────────────────────────────────── -->
        <Grid Grid.Row="1" ColumnDefinitions="110,*">

            <!-- Name column -->
            <atom:ScrollViewer Grid.Column="0"
                          x:Name="NameScrollViewer"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="NameColumn" Spacing="0">
                    <!-- Header spacer matching AvailabilityTimelineControl.HeaderHeight -->
                    <Border Height="{x:Static av:AvailabilityTimelineControl.HeaderHeight}"/>
                    <!-- One name per row -->
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="av:ParticipantAvailabilityViewModel">
                                <Border Height="{x:Static av:AvailabilityTimelineControl.RowHeight}"
                                        Margin="0,0,0,4"
                                        Classes.organizer="{Binding IsOrganizerRow}">
                                    <TextBlock Classes="ParticipantName"
                                               Text="{Binding DisplayName}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </atom:ScrollViewer>

            <!-- Timeline column -->
            <atom:ScrollViewer Grid.Column="1"
                          x:Name="TimelineScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Hidden">
                <Panel x:Name="TimelinePanel" MinWidth="480">

                    <!-- The grid renderer -->
                    <av:AvailabilityTimelineControl
                        x:Name="TimelineControl"
                        Rows="{Binding Rows}"
                        TimeLabels="{Binding TimeLabels}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"/>

                    <!-- Draggable slot overlay — positioned in code-behind via Canvas.Left / Width -->
                    <Canvas x:Name="OverlayCanvas"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            IsHitTestVisible="True"
                            PointerPressed="OnOverlayCanvasPointerPressed"
                            PointerMoved="OnOverlayCanvasPointerMoved"
                            PointerExited="OnOverlayCanvasPointerExited"
                            PointerReleased="OnOverlayCanvasPointerReleased">

                        <Border x:Name="SlotBorder"
                                Classes="SlotOverlay"
                                Canvas.Top="{x:Static av:AvailabilityTimelineControl.HeaderHeight}"
                                IsHitTestVisible="True">
                            <Border Classes="ResizeHandle"
                                    x:Name="ResizeHandle"/>
                        </Border>
                    </Canvas>
                </Panel>
            </atom:ScrollViewer>
        </Grid>

        <!-- ── Row 2: selected label + action buttons ────────────────────── -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <TextBlock Grid.Column="0"
                       Text="{Binding SelectedSlotLabel}"
                       FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <atom:Button x:Name="UseSlotButton"
                        Content="Use this slot"
                        MinWidth="120"
                        Click="OnUseSlotClick"/>
                <atom:Button Content="Cancel"
                        MinWidth="80"
                        Click="OnCancelClick"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
