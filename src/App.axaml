<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="perinma.App"
             xmlns:local="using:perinma"
             RequestedThemeVariant="Light">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="CalendarDayButton.highlighted /template/ Border#Root">
            <Setter Property="Background" Value="#330078D4" />
        </Style>
        <Style Selector="CalendarDayButton.highlighted:inactive /template/ Border#Root">
            <Setter Property="Background" Value="#330078D4" />
        </Style>
        <Style Selector="CalendarDayButton.highlighted:inactive /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource CalendarViewCalendarItemForeground}" />
        </Style>
    </Application.Styles>
</Application>